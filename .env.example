# Base de datos. Para desarrollo local, SQLite basta:
DATABASE_URL="file:./dev.db"
# En producción (Vercel), usa Postgres (p.ej. Vercel Postgres / Neon):
# DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Clave de 32 bytes (64 caracteres hex) para cifrar credenciales de La Comer con AES-256-GCM.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="reemplaza_con_64_caracteres_hexadecimales_aqui_0000000000000000"

# Si true, el módulo de automatización corre Chromium visible (útil para depurar login/checkout).
LACOMER_HEADFUL="false"
